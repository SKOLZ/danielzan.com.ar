---
import type { Slug } from "sanity";
import PortableText from "../components/PortableText/PortableText.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadQuery } from "../sanity/lib/load-query";
import { formatDate } from "../utils/date";

const pageTitle = "Notas | Danielzan";

const { data: posts } = await loadQuery<
  {
    slug: Slug;
    title: string;
    firstPublished: string;
    lastPublished: string;
  }[]
>({
  query: `*[_type == "post"] | order(firstPublished desc) {
    ...,
    body[] {
      ...,
      asset->{
        _id,
        url,
        metadata { dimensions }
      }
    }
  }`,
});
---

<BaseLayout pageTitle={pageTitle}>
  <section class="notes-list">
    {
      posts.map((post) => (
        <a class="note" href={`/notas/${post.slug.current}`}>
          <h3 class="title-2 note-title">{post.title}</h3>
          <p class="note-date text-2">{formatDate(post.firstPublished)}</p>
        </a>
      ))
    }
  </section>
</BaseLayout>

<style>
  .notes-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 32px 24px;
    counter-reset: note;
  }

  .note {
    display: flex;
    align-items: end;
    padding: 10px 4px;
    border-radius: 4px;
    border: 1px solid transparent;
    transition:
      background-color 0.3s,
      border-color 0.3s;

    &:hover {
      background-color: var(--black-950);
      border: 1px solid var(--black-900);

      .note-title::before {
        color: var(--black-800);
      }

      .note-title::after {
        background-color: var(--black-800);
      }
    }
  }

  .note-title {
    color: var(--black-50);
    flex: 1;
    position: relative;

    &::before {
      counter-increment: note;
      content: counter(note);
      font-family: var(--font-zodiak);
      font-size: 2rem;
      font-weight: 300;
      text-transform: uppercase;
      text-box-trim: trim-both;
      text-box-edge: cap alphabetic;
      color: var(--black-850);
      width: 2ex;
      text-align: center;
      display: inline-block;
      margin-inline-end: 8px;
      vertical-align: middle;
      transition: color 0.3s;
    }

    &::after {
      content: "";
      position: absolute;
      width: stretch;
      height: 1px;
      background-color: var(--black-850);
      bottom: 0;
      margin-inline: 10px;
      transition: background-color 0.3s;
    }
  }

  .note-date {
    text-box-trim: trim-both;
    text-box-edge: cap alphabetic;
  }
</style>
