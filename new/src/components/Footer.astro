---
import SkzDsgnLogo from "../assets/skolz_design_logo.svg";
---

<footer class="container footer">
  <a
    href="https://skolz.design"
    target="_blank"
    rel="noopener noreferrer"
    class="skolz-logo"
  >
    <SkzDsgnLogo />
  </a>
</footer>

<style>
  .footer {
    display: flex;
    justify-content: flex-end;
  }

  .skolz-logo {
    color: var(--black-500);
    transition: color 0.2s ease-in-out;

    &:hover {
      color: var(--black-300);
    }
  }
</style>
