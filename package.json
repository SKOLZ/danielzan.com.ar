{
  "name": "danielzan.com.ar",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "migrate": "npx tsx scripts/migrate.ts",
    "studio:dev": "pnpm --filter danielzan-studio dev",
