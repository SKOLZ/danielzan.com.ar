    "studio:schema:deploy": "pnpm --filter danielzan-studio run schema:deploy"
  },
  "dependencies": {
    "@sanity/astro": "^3.5.0",
    "@sanity/image-url": "^2.1.1",
    "astro": "^7.1.3",
    "astro-portabletext": "^0.13.0",
    "dotenv": "^17.4.2",
    "groq": "^6.6.0"
  },
  "devDependencies": {
    "@portabletext/block-tools": "^5.1.12",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.1"
  }
}
