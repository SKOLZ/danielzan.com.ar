---
import BaseLayout from "../layouts/BaseLayout.astro";
import { sanityClient } from "sanity:client";
import { PHOTO_GALLERIES_QUERY, VIDEOS_QUERY, urlFor } from "../lib/sanity";

const [galleries, videos] = await Promise.all([
  sanityClient.fetch(PHOTO_GALLERIES_QUERY),
  sanityClient.fetch(VIDEOS_QUERY),
]);

const categories = [...new Set([...galleries, ...videos].map((c) => c.category).filter(Boolean))];
---
<BaseLayout title="Media" description="Fotos, videos y canciones de Daniel Zanzotti" activePage="media">
  <div class="container" style="padding: 2rem 0;">
    <h1 class="page-title">Media</h1>

    <div class="filter-bar" style="gap: 2.5rem; margin-bottom: 1.5rem;">
      <div class="filter-group">
        <label for="type-filter" class="filter-label">Tipo de media</label>
        <select id="type-filter" class="filter-select">
          <option value="">Todas</option>
          <option value="fotos">Fotos</option>
          <option value="videos">Videos</option>
        </select>
      </div>
      {categories.length > 0 && (
        <div class="filter-group">
          <label for="category-filter" class="filter-label">Categoría</label>
          <select id="category-filter" class="filter-select">
            <option value="">Todas</option>
            {categories.map((cat) => (
              <option value={cat}>{cat}</option>
            ))}
          </select>
        </div>
      )}
    </div>

    <div class="media-grid">
      {galleries.map((gallery) => (
        <div class="media-card" data-type="fotos" data-category={gallery.category || ""}>
          {gallery.photos?.[0]?.asset?._ref && (
            <img src={urlFor(gallery.photos[0]).width(400).height(225).url()} alt={gallery.title} style="aspect-ratio: 16/9; object-fit: cover; width: 100%;" />
          )}
          <div class="media-card-body">
            <span class="category-tag">{gallery.category || "General"}</span>
            <h3>{gallery.title}</h3>
          </div>
        </div>
      ))}
    </div>

    <div class="media-grid">
      {videos.map((video) => (
        <div class="media-card" data-type="videos" data-category={video.category || ""}>
          <a href={`https://www.youtube.com/watch?v=${video.youtubeId}`} target="_blank" rel="noopener noreferrer" class="video-thumb">
            <img src={`https://img.youtube.com/vi/${video.youtubeId}/hqdefault.jpg`} alt={video.title} loading="lazy" />
          </a>
          <div class="media-card-body">
            <span class="category-tag">{video.category || "General"}</span>
            <h3>{video.title}</h3>
            {video.description && <p class="media-desc">{video.description}</p>}
          </div>
        </div>
      ))}
    </div>

    <p class="media-empty" hidden>No hay contenido para ese filtro.</p>
  </div>
</BaseLayout>

<script>
  function applyMediaFilter() {
    const typeFilter = document.getElementById("type-filter");
    const categoryFilter = document.getElementById("category-filter");
    if (!typeFilter || !categoryFilter) return;
    const tipo = typeFilter.value;
    const cat = categoryFilter.value;
    const cards = document.querySelectorAll(".media-card");
    let visible = 0;
    for (const card of cards) {
      const show =
        (!tipo || card.dataset.type === tipo) &&
        (!cat || card.dataset.category === cat);
      card.hidden = !show;
      if (show) visible++;
    }
    const empty = document.querySelector(".media-empty");
    if (empty) empty.hidden = visible > 0;
  }

  document.addEventListener("astro:page-load", () => {
    const typeFilter = document.getElementById("type-filter");
    const categoryFilter = document.getElementById("category-filter");
    if (!typeFilter || !categoryFilter) return;

    const onSelect = (key) => (el) => {
      const url = new URL(window.location.href);
      if (el.value) url.searchParams.set(key, el.value);
      else url.searchParams.delete(key);
      history.pushState({}, "", url.pathname + url.search);
      applyMediaFilter();
    };

    typeFilter.addEventListener("change", () => onSelect("tipo")(typeFilter));
    categoryFilter.addEventListener("change", () => onSelect("categoria")(categoryFilter));

    const params = new URLSearchParams(window.location.search);
    typeFilter.value = params.get("tipo") || "";
    categoryFilter.value = params.get("categoria") || "";
    applyMediaFilter();
  });

  window.addEventListener("popstate", applyMediaFilter);
</script>
