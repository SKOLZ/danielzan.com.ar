---
import { slugify } from "../lib/slugify";
import { positionClass } from "../lib/positions";

export interface ResultItem {
  date: string;
  position: string;
  category: string;
}

export interface SeasonItem {
  year: string;
  finalPosition: string;
  category: string;
}

interface Props {
  seasons: SeasonItem[];
  categories: string[];
  results: ResultItem[];
}

const { seasons, categories, results } = Astro.props;

const formatDate = (d: string) => {
  if (!d) return "";
  const parts = d.split("-");
  if (parts.length === 3) return `${parts[2]}.${parts[1]}.${parts[0]}`;
  return d;
};

const resultClass = (pos: string) => {
  const p = pos.toLowerCase().trim();
  if (p === "1ro" || p === "1°" || p === "1" || p.startsWith("1"))
    return "gold";
  if (p === "2do" || p === "2°" || p === "2" || p.startsWith("2"))
    return "silver";
  if (p === "3ro" || p === "3°" || p === "3" || p.startsWith("3"))
    return "bronze";
  return "";
};
---

<table class="seasons-table">
  <thead>
    <tr>
      <th>Año</th>
      <th>Posición</th>
      <th>Categoría</th>
    </tr>
  </thead>
  <tbody>
    {
      seasons.map((s) => (
        <tr>
          <td style="font-family: var(--font-mono); font-weight: 700; color: var(--white);">
            {s.year}
          </td>
          <td style={positionClass(s.finalPosition) ? `color: var(--${positionClass(s.finalPosition)});` : ""}>
            {s.finalPosition}
          </td>
          <td style="color: var(--muted);">{s.category}</td>
        </tr>
      ))
    }
  </tbody>
</table>

<h2 class="page-title results-title" id="resultados">Todos los resultados</h2>

{
  categories.length > 0 && (
    <div class="filter-bar">
      <span class="filter-label">Categorías</span>
      <a href="/resultados" class="filter-btn" data-filter="">
        Todas
      </a>
      {categories.map((cat) => (
        <a
          href={`/resultados?categoria=${slugify(cat)}`}
          class="filter-btn"
          data-filter={slugify(cat)}
          data-name={cat}
        >
          {cat}
        </a>
      ))}
    </div>
  )
}

<table class="results-table">
  <thead>
    <tr>
      <th>Fecha</th>
      <th>Posición</th>
      <th>Categoría</th>
    </tr>
  </thead>
  <tbody id="results-body">
    {
      results.length === 0 && (
        <tr id="results-empty">
          <td
            colspan="3"
            style="text-align: center; color: var(--muted); padding: 2rem;"
          >
            Sin resultados para mostrar.
          </td>
        </tr>
      )
    }
    {
      results.map((r) => (
        <tr data-category={r.category ?? ""}>
          <td style="color: var(--muted); font-family: var(--font-mono); white-space: nowrap;">
            {formatDate(r.date)}
          </td>
          <td class={`result-pos ${resultClass(r.position)}`}>{r.position}</td>
          <td style="color: var(--muted);">{r.category}</td>
        </tr>
      ))
    }
  </tbody>
</table>

<div class="pagination" id="results-pager"></div>

<script>
  document.addEventListener("astro:page-load", () => {
    const body = document.getElementById("results-body");
    if (!body) return;

    const PAGE_SIZE = 30;

    const rows = Array.from(body.querySelectorAll("tr[data-category]"));
    const filterBar = document.querySelector(".filter-bar");
    const pagerEl = document.getElementById("results-pager");
    const titleEl = document.getElementById("resultados");

    const filterBtns = Array.from(
      filterBar?.querySelectorAll(".filter-btn") ?? [],
    );

    const slugToName = new Map<string, string>();
    for (const btn of filterBtns) {
      const slug = btn.dataset.filter ?? "";
      const name = btn.dataset.name ?? "";
      if (slug && name) slugToName.set(slug, name);
    }
    const nameToSlug = new Map<string, string>(
      Array.from(slugToName, ([s, n]) => [n, s]),
    );

    const readParams = () => {
      const p = new URLSearchParams(location.search);
      const catSlug = (p.get("categoria") ?? "").toLowerCase();
      const catName = slugToName.get(catSlug) ?? "";
      const page = Number.parseInt(p.get("page") ?? "1", 10);
      return { catName, page: Number.isFinite(page) && page >= 1 ? page : 1 };
    };

    const countFor = (catName: string) =>
      catName
        ? rows.filter((r) => r.dataset.category === catName).length
        : rows.length;

    const totalPagesFor = (catName: string) =>
      Math.max(1, Math.ceil(countFor(catName) / PAGE_SIZE));

    const buildUrl = (catSlug: string, page: number) => {
      const p = new URLSearchParams();
      if (catSlug) p.set("categoria", catSlug);
      if (page > 1) p.set("page", String(page));
      const qs = p.toString();
      return qs ? `/resultados?${qs}` : "/resultados";
    };

    const pagerItems = (current: number, total: number): (number | "…")[] => {
      if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
      const items: (number | "…")[] = [1];
      const start = Math.max(2, current - 1);
      const end = Math.min(total - 1, current + 1);
      if (start > 2) items.push("…");
      for (let i = start; i <= end; i++) items.push(i);
      if (end < total - 1) items.push("…");
      items.push(total);
      return items;
    };

    const renderPager = (current: number, total: number, catSlug: string) => {
      if (!pagerEl) return;
      if (total <= 1) {
        pagerEl.style.display = "none";
        pagerEl.innerHTML = "";
        return;
      }
      pagerEl.style.display = "";

    const link = (
      page: number,
      cls: string,
      label: string,
      disabled: boolean,
      ariaLabel?: string,
    ) =>
      `<a href="${buildUrl(catSlug, page)}" data-page="${page}" class="${cls}"${ariaLabel ? ` aria-label="${ariaLabel}"` : ""}${disabled ? ' aria-disabled="true"' : ""}>${label}</a>`;

    const chevronLeft =
      '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6" /></svg>';
    const chevronRight =
      '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>';

    const prev = link(
      Math.max(1, current - 1),
      current <= 1 ? "page-nav is-disabled" : "page-nav",
      chevronLeft,
      current <= 1,
      "Anterior",
    );
    const next = link(
      Math.min(total, current + 1),
      current >= total ? "page-nav is-disabled" : "page-nav",
      chevronRight,
      current >= total,
      "Siguiente",
    );

      const nums = pagerItems(current, total)
        .map((p) =>
          p === "…"
            ? `<span class="ellipsis">…</span>`
            : p === current
              ? `<span class="current">${p}</span>`
              : link(p, "page-num", String(p), false),
        )
        .join("");

      pagerEl.innerHTML = prev + nums + next;
    };

    const applyView = () => {
      const { catName, page } = readParams();
      const total = totalPagesFor(catName);
      const cur = Math.min(page, total);
      const activeSlug = nameToSlug.get(catName) ?? "";

      let visible = 0;
      for (const r of rows) {
        const matches = !catName || r.dataset.category === catName;
        if (!matches) {
          r.style.display = "none";
          continue;
        }
        const inPage =
          visible >= (cur - 1) * PAGE_SIZE && visible < cur * PAGE_SIZE;
        r.style.display = inPage ? "" : "none";
        visible++;
      }

      const empty = document.getElementById("results-empty");
      if (empty) empty.style.display = visible > 0 ? "none" : "";

      for (const btn of filterBtns) {
        btn.classList.toggle("active", (btn.dataset.filter ?? "") === activeSlug);
      }

      renderPager(cur, total, activeSlug);
    };

    const navigate = (catSlug: string, page: number) => {
      history.pushState({}, "", buildUrl(catSlug, page));
      applyView();
      titleEl?.scrollIntoView({ behavior: "smooth", block: "start" });
    };

    filterBar?.addEventListener("click", (e) => {
      const a = (e.target as HTMLElement).closest("a[data-filter]");
      if (!a) return;
      e.preventDefault();
      navigate(a.dataset.filter ?? "", 1);
    });

    pagerEl?.addEventListener("click", (e) => {
      const a = (e.target as HTMLElement).closest("a[data-page]");
      if (!a) return;
      e.preventDefault();
      if (
        a.classList.contains("is-disabled") ||
        a.getAttribute("aria-disabled") === "true"
      )
        return;
      const page = Number.parseInt(a.dataset.page ?? "1", 10);
      const { catName } = readParams();
      navigate(nameToSlug.get(catName) ?? "", page);
    });

    if (!window.__dzResultsBound) {
      window.addEventListener("popstate", applyView);
      window.__dzResultsBound = true;
    }

    applyView();
  });
</script>
