---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Player from "../components/Player.astro";

export interface Props {
  title?: string;
  description?: string;
  activePage?: string;
}

const { title = "Danielzan", description = "Historia del piloto Daniel Zanzotti - Sport Prototipo", activePage = "" } = Astro.props;

const navItems = [
  { href: "/", label: "Inicio", id: "home" },
  { href: "/about", label: "Sobre mí", id: "about" },
  { href: "/media", label: "Media", id: "media" },
  { href: "/resultados", label: "Resultados", id: "resultados" },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Danielzan</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600&family=Oswald:wght@400;600;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <ClientRouter />
  </head>
  <body>
    <header class="header">
      <div class="container header-inner">
        <a href="/" class="header-title">
          Daniel<span>zan</span>
        </a>
        <nav class="nav">
          {navItems.map((item) => (
            <a href={item.href} class={activePage === item.id ? "active" : ""}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer-inner">
        <div class="footer-section">
          <span style="color: var(--muted); font-size: 0.85rem;">
            &copy; {new Date().getFullYear()} Daniel Zanzotti
          </span>
        </div>
      </div>
    </footer>

    <Player />
  </body>
</html>
